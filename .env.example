# YUNA Environment Variables
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control

# === SITE ===
NEXT_PUBLIC_SITE_URL=https://yunatea.in

# === PAYMENTS (Razorpay — India) ===
# Test mode keys until merchant account is verified
# Get keys from https://dashboard.razorpay.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER
RAZORPAY_KEY_SECRET=PLACEHOLDER_DO_NOT_COMMIT

# === EMAIL / NEWSLETTER ===
# Klaviyo, Mailchimp, or similar
EMAIL_PROVIDER_API_KEY=PLACEHOLDER

# === ANALYTICS ===
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-PLACEHOLDER

# === SHIPPING ===
# Shiprocket or similar — API key for rate calculation
SHIPPING_API_KEY=PLACEHOLDER
